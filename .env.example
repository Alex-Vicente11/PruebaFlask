# Base de Datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=list_products

# JWT Authentication
JWT_SECRET_KEY=change-this-to-a-random-secret-key-in-production

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_APP=app.py

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=5002

# CORS Configuration (separar con comas si son múltiples)
ALLOWED_ORIGINS=*

# Guest User Configuration
GUEST_CLEANUP_DAYS=30
